    "build": "bun run index.ts --local && bun run scripts/gen-index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/turndown": "^5.0.6",
    "node-html-parser": "^9.0.0",
    "turndown": "^7.2.4"
  }
}