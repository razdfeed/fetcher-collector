{
  "name": "fetcher-collector",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "collect": "bun run index.ts",
    "local": "bun run index.ts --local",
    "dev": "bun run index.ts --dry-run",
    "gen-index": "bun run scripts/gen-index.ts",
    "build": "bun run index.ts --local && bun run scripts/gen-index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}